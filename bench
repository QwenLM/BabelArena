#!/usr/bin/env python3
"""Unified driver for the multilingual agent benchmark suite.

Wraps four benchmarks that each keep their own runner, their own language
spelling, and their own model-config format:

    tau3          `tau2 run`,  language via the TAU2_LANGUAGE env var
    vitabench     `vita run`,  language via --language
    deepplanning  `run_all.sh`, language via DEEPPLANNING_LANGUAGE
    claw          `claw-eval batch`, language via --language

This script does not reimplement any of them. It translates one set of
arguments into what each runner expects, renders the model config into the
four native formats, and records where each run put its output. Scores are
produced by each benchmark's own evaluator, unchanged, so numbers stay
comparable with runs made through the native CLIs.

Usage:
    bench setup                      # create the four virtualenvs
    bench check                      # verify data + config, no LLM calls
    bench languages                  # list supported languages
    bench run --benchmark all --language japanese --agent-model gpt-4.1
    bench report --run-id <id>
"""

from __future__ import annotations

