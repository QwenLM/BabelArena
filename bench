from typing import Any, Optional

REPO = Path(__file__).resolve().parent
BENCHMARKS = REPO / "benchmarks"
CONFIGS = REPO / "configs"
RESULTS = REPO / "results"
DATA = REPO / "data"
RUNTIME = REPO / ".runtime"
VENVS = REPO / ".venvs"

BENCH_NAMES = ("tau3", "vitabench", "deepplanning", "claw")

# Where `bench fetch-data` pulls the ~14 GB of benchmark data from. Set this to
# the published dataset before release; until then pass --source <local path>.
DATA_SOURCE_DEFAULT = ""

# Domains that make up the `standard` release of each benchmark. These are the
# defaults; --domain narrows them.
STANDARD_DOMAINS = {
    "tau3": ["airline", "retail", "telecom", "banking_knowledge"],
    # `cross` is the cross-domain task set, which vita addresses as the
    # comma-joined domain list rather than as a domain of its own.
    "vitabench": ["delivery", "instore", "ota", "cross"],
    "deepplanning": ["travel", "shopping"],
    # claw's three splits. They always run together as one batch per language
    # (the procedure the reported numbers come from), so --domain cannot pick
    # one of them out -- see _plan_claw.
    "claw": ["general", "multimodal", "multi_turn"],
}

# Acceptable interpreters per benchmark, most preferred first. tau3 declares
# >=3.12,<3.14; deepplanning pins a Hugging Face stack built for 3.10;
# vitabench declares >=3.10 and rides along with tau3's interpreter; claw
# declares >=3.11. They cannot share one, which is why each gets its own venv.
#
# Listed explicitly rather than falling back to whatever `python3` happens to
# be: a silent fallback to an out-of-range interpreter fails much later, deep
# inside a dependency install, where the cause is no longer obvious.
PYTHON_FOR = {
    "tau3": ["python3.12", "python3.13"],
    "vitabench": ["python3.12", "python3.11", "python3.10", "python3.13"],
    "deepplanning": ["python3.10", "python3.11"],
    "claw": ["python3.12", "python3.11", "python3.13"],
}


def _find_python(benchmark: str) -> str:
    for exe in PYTHON_FOR[benchmark]:
        found = shutil.which(exe)
        if found:
            return found
    die(
        f"no suitable Python for {benchmark}.\n"
        f"  tried: {', '.join(PYTHON_FOR[benchmark])}\n"
        f"  install one of them, or point PATH at it"
    )


# --------------------------------------------------------------------------
# small helpers
# --------------------------------------------------------------------------

def die(msg: str, code: int = 1) -> "NoReturn":  # type: ignore[valid-type]
    print(f"bench: error: {msg}", file=sys.stderr)
    raise SystemExit(code)


def warn(msg: str) -> None:
    print(f"bench: warning: {msg}", file=sys.stderr)


def _load_yaml(path: Path) -> Any:
    try:
        import yaml
    except ImportError:
        die(
            "PyYAML is required by bench itself.\n"
            "  pip install pyyaml   (or run bench from any of the four venvs)"
        )
    with path.open(encoding="utf-8") as f:
        return yaml.safe_load(f)


