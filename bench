@dataclass(frozen=True)
class Language:
    code: str
    name: str
    tau3: Optional[str]
    vita: Optional[str]
    deep: Optional[str]
    claw: Optional[str] = None

    def for_benchmark(self, benchmark: str) -> Optional[str]:
        return {"tau3": self.tau3, "vitabench": self.vita, "deepplanning": self.deep,
                "claw": self.claw}[benchmark]


class LanguageRegistry:
    def __init__(self, path: Path):
        raw = _load_yaml(path)
        self.languages = [Language(**entry) for entry in raw["languages"]]
        self._by_code = {lang.code: lang for lang in self.languages}
        self._by_name = {lang.name: lang for lang in self.languages}
        self._aliases = {k.lower(): v for k, v in (raw.get("aliases") or {}).items() if v}

    def resolve(self, spec: str) -> Language:
        key = spec.strip().lower().replace("-", "_")
        if key in self._aliases:
            key = self._aliases[key]
        if key in self._by_code:
            return self._by_code[key]
        if key in self._by_name:
            return self._by_name[key]
        # tolerate the spaced form ("eastern panjabi")
        spaced = key.replace("_", " ")
        for lang in self.languages:
            if lang.name.replace("_", " ") == spaced:
                return lang
        die(
            f"unknown language {spec!r}.\n"
            f"  supported: {', '.join(l.code for l in self.languages)}\n"
            f"  run `bench languages` for the full table"
        )

    def __iter__(self):
        return iter(self.languages)


