_ENV_REF = re.compile(r"\$\{([A-Za-z_][A-Za-z0-9_]*)\}")
# Anything that looks like a real credential sitting in the config file.
_BARE_KEY = re.compile(r"(sk-[A-Za-z0-9_\-]{16,}|Bearer\s+[A-Za-z0-9_\-.]{16,})")


def _expand(value: Any, missing: set[str]) -> Any:
    """Recursively expand ${VAR} references using the environment."""
    if isinstance(value, str):
        def sub(m: re.Match) -> str:
            name = m.group(1)
            if name not in os.environ:
                missing.add(name)
                return m.group(0)
            return os.environ[name]
        return _ENV_REF.sub(sub, value)
    if isinstance(value, dict):
        return {k: _expand(v, missing) for k, v in value.items()}
    if isinstance(value, list):
        return [_expand(v, missing) for v in value]
    return value


class ModelConfig:
    """configs/models.yaml, rendered into each benchmark's native format."""

    def __init__(self, path: Path):
        if not path.exists():
            die(
                f"{path.relative_to(REPO)} not found.\n"
                f"  cp configs/models.yaml.example configs/models.yaml   # then edit"
            )
        self.path = path
        raw_text = path.read_text(encoding="utf-8")
        found = _BARE_KEY.search(_ENV_REF.sub("", raw_text))
        if found:
            die(
                f"{path.relative_to(REPO)} appears to contain a literal API key "
                f"({found.group(0)[:12]}...).\n"
                f"  Use a ${{ENV_VAR}} reference instead so the file stays safe to commit."
            )
        self.raw = _load_yaml(path)
        self.roles = self.raw.get("roles") or {}
        self._names = {m["name"] for m in self.raw.get("models", [])}
        # tau3 and vitabench have no alias layer: whatever a models.yaml entry is
        # called is sent to the endpoint as the model id. deepplanning does have
        # one (model_name). So this config keeps friendly names and resolves them
        # to the real id wherever the target cannot.
        self._real = {m["name"]: m.get("model_name", m["name"])
                      for m in self.raw.get("models", [])}

    def real_id(self, name: Optional[str]) -> Optional[str]:
        """The id the endpoint knows this model by."""
        return self._real.get(name, name) if name else None

    def require(self, name: str, what: str) -> str:
        if name not in self._names:
            die(
                f"{what} model {name!r} is not defined in {self.path.name}.\n"
                f"  defined: {', '.join(sorted(self._names)) or '(none)'}"
            )
        return name

    def role(self, role: str, override: Optional[str], what: str) -> Optional[str]:
        name = override or self.roles.get(role)
        return self.require(name, what) if name else None

    def render(self) -> dict[str, Path]:
        """Write the three list-of-models config files; return their paths.

        These are the only files that hold an expanded credential -- the runners
        need a real key on disk. They are written 0600, live under .runtime/
        (git-ignored), and `bench clean` removes them. Do not copy them around.
        claw's config is per-run (it is keyed by role, not by model), so it is
        written later by render_claw().
        """
        missing: set[str] = set()
        cfg = _expand(self.raw, missing)
        if missing:
            die(
                "model config references environment variables that are not set: "
                + ", ".join(sorted(missing))
                + "\n  export them, or put them in a .env you source before running"
            )
        RUNTIME.mkdir(exist_ok=True)
        self._cfg = cfg

        import yaml

        # tau3 and vitabench share the same models.yaml schema, but neither has
        # an alias layer -- the entry name goes on the wire as the model id. Key
        # the emitted entries by the real id, and drop the alias-only field.
        # Two roles pointing at one model collapse into one entry, which is all
        # those runners can express anyway. `claw:` holds claw-only settings and
        # must not reach a runner that would send it on the wire.
        by_real: dict[str, dict] = {}
        for m in cfg.get("models", []):
            entry = {k: v for k, v in m.items() if k not in ("model_name", "claw")}
            entry["name"] = m.get("model_name", m["name"])
            prior = by_real.get(entry["name"])
            if prior and prior != entry:
                warn(f"models.yaml: {m['name']!r} and an earlier alias both map to "
                     f"{entry['name']!r} with different settings; keeping the first")
                continue
            by_real[entry["name"]] = entry
        shared = {"default": cfg.get("default", {}), "models": list(by_real.values())}
        paths = {}
        for key, fname in (("tau3", "tau3_models.yaml"), ("vitabench", "vita_models.yaml")):
            p = RUNTIME / fname
            p.write_text(yaml.safe_dump(shared, allow_unicode=True, sort_keys=False), encoding="utf-8")
            p.chmod(0o600)
            paths[key] = p

        # deepplanning wants JSON keyed by config name, and reads its API key
        # from an env var rather than from an Authorization header. Rather than
        # invent a variable per model, publish one and point every model at it.
        #
        # It also wants a different base_url shape: it drives the OpenAI SDK,
        # which appends /chat/completions itself, whereas tau3 and vitabench
        # POST base_url verbatim. configs/models.yaml carries the full endpoint
        # (what tau3/vitabench need) and the suffix is stripped here, so one
        # config serves all three.
        default = cfg.get("default", {})
        dp_models: dict[str, Any] = {}
        for m in cfg.get("models", []):
            merged = {**default, **m}
            auth = (merged.get("headers") or {}).get("Authorization", "")
            token = auth.split(None, 1)[1] if auth.lower().startswith("bearer ") else auth
            base = str(merged.get("base_url", ""))
            for suffix in ("/chat/completions", "/completions"):
                if base.endswith(suffix):
                    base = base[: -len(suffix)]
                    break
            entry = {
                "model_name": merged.get("model_name", merged["name"]),
                "model_type": merged.get("model_type", "openai"),
                "base_url": base,
                "api_key_env": f"REQUEST_KEY_{_env_safe(merged['name'])}",
                "temperature": merged.get("temperature", 0.0),
            }
            for opt in ("max_tokens", "max_completion_tokens", "extra_body", "reasoning_effort"):
                if opt in merged:
                    entry[opt] = merged[opt]
            dp_models[merged["name"]] = entry
            # deepplanning resolves the key at call time from this variable.
            os.environ.setdefault(entry["api_key_env"], token)
        p = RUNTIME / "deepplanning_models.json"
        p.write_text(json.dumps({"models": dp_models}, ensure_ascii=False, indent=2), encoding="utf-8")
        p.chmod(0o600)
        paths["deepplanning"] = p
        return paths

    def render_claw(self, agent: str, judge: str, user: str, run_id: str) -> Path:
        """Write claw's config for one run and return its path.

        claw takes one section per role rather than a list of models: the agent
        becomes `model`, the evaluator `judge`, the user simulator
        `user_agent_model`. Call after render(), which publishes every model's
        key as REQUEST_KEY_<NAME>.

        Unlike the other three files this one holds no credential. claw expands
        a value that is exactly ${VAR} when it loads the file, so api_key names
        that variable and the key itself stays in the environment.

        A models.yaml entry may carry a `claw:` mapping, applied last, for
        settings only claw has: provider (anthropic_native), api_format (vertex,
        user simulator only), echo_reasoning, input_modalities, or a base_url
        for a different protocol route.
        """
        import yaml

        cfg = self._cfg
        default = cfg.get("default", {})
        merged = {m["name"]: {**default, **m} for m in cfg.get("models", [])}

        def section(name: str) -> tuple[dict, dict]:
            m = merged[name]
            # claw drives the OpenAI SDK, which appends /chat/completions itself.
            base = str(m.get("base_url", ""))
            for suffix in ("/chat/completions", "/completions"):
                if base.endswith(suffix):
                    base = base[: -len(suffix)]
                    break
            return m, {"api_key": "${REQUEST_KEY_" + _env_safe(name) + "}",
                       "base_url": base,
                       "model_id": m.get("model_name", m["name"])}

        def overlay(m: dict, out: dict) -> dict:
            extra = dict(m.get("claw") or {})
            if "api_key" in extra:
                warn(f"models.yaml: {m['name']}.claw.api_key ignored -- claw uses the "
                     f"key from headers.Authorization like every other benchmark")
                del extra["api_key"]
            out.update(extra)
            return out

        a, model = section(agent)
        # None is meaningful: claw then omits temperature, which some
        # endpoints require (they 400 on any value for reasoning models).
        model["temperature"] = a.get("temperature", 0.0)
        if a.get("reasoning_effort") is not None:
            model["reasoning_effort"] = a["reasoning_effort"]
        if a.get("max_input_tokens"):
            model["context_window"] = int(a["max_input_tokens"])
        # claw has no max_tokens field; output limits travel in the request body.
        body = dict(a.get("extra_body") or {})
        for opt in ("max_tokens", "max_completion_tokens", "thinking"):
            if a.get(opt) is not None:
                body.setdefault(opt, a[opt])
        if body:
            model["extra_body"] = body

        j, judge_sec = section(judge)
        judge_sec["enabled"] = True

        u, user_sec = section(user)
        if u.get("extra_body"):
            user_sec["extra_body"] = dict(u["extra_body"])

        doc = {"model": overlay(a, model),
               "judge": overlay(j, judge_sec),
               "user_agent_model": overlay(u, user_sec)}
        RUNTIME.mkdir(exist_ok=True)
        p = RUNTIME / f"claw_{run_id}.yaml"
        p.write_text(yaml.safe_dump(doc, allow_unicode=True, sort_keys=False), encoding="utf-8")
        p.chmod(0o600)
        return p


def _env_safe(name: str) -> str:
    return re.sub(r"[^A-Za-z0-9]", "_", name).upper()


# --------------------------------------------------------------------------
# run plan
# --------------------------------------------------------------------------

@dataclass
class Step:
    """One benchmark x language invocation."""
    benchmark: str
    language: Language
    argv: list[str]
    env: dict[str, str]
    cwd: Path
    output_hint: str
    notes: list[str] = field(default_factory=list)
    trial: Optional[int] = None   # set only on deepplanning's per-trial steps


def venv_bin(benchmark: str, exe: str) -> Path:
    return VENVS / benchmark / "bin" / exe


def _domains_for(benchmark: str, requested: Optional[list[str]]) -> Optional[list[str]]:
    """Which of --domain apply to this benchmark.

    The four have disjoint domain names (airline / delivery / travel / general), so
    `--benchmark all --domain airline` must mean "airline where it exists",
    not "pass airline to vitabench and watch it reject the value". Returns None
    when the benchmark has none of the requested domains, so the caller can skip
    it with a clear message rather than running its full default set.
    """
    known = STANDARD_DOMAINS[benchmark]
    if not requested:
        return known
    keep = [d for d in requested if d in known]
    return keep or None


def _plan_tau3(a, lang, models, cfgs, run_id) -> list[Step]:
    if lang.tau3 is None:
        die(f"tau3 does not ship {lang.name!r}")
    domains = _domains_for("tau3", a.domain)
    if domains is None:
        warn(f"skipping tau3: none of {a.domain} is one of its "
             f"domains ({', '.join(STANDARD_DOMAINS['tau3'])})")
        return []
    steps = []
    for domain in domains:
        save_to = f"{run_id}/{lang.code}/{domain}"
        argv = [
            str(venv_bin("tau3", "tau2")), "run",
            "--domain", domain,
            "--agent-llm", models.real_id(models.require(a.agent_model, "agent")),
            "--num-trials", str(a.num_trials),
            "--task-subset", a.subset,
            "--max-concurrency", str(a.concurrency),
            "--save-to", save_to,
            # Re-running a --run-id resumes. Without this tau2 stops to ask
            # y/n on stdin, which hangs or fails a run started in the background.
            "--auto-resume",
        ]
        if a.num_tasks:
            argv += ["--num-tasks", str(a.num_tasks)]
        user = models.role("user", a.user_model, "user-simulator")
        if user:
            argv += ["--user-llm", models.real_id(user)]
        # tau3 scores natural-language assertions with an LLM whose default is a
        # hardcoded gpt-4.1 id. Left unset, every task dies with
        # "Model 'gpt-4.1-2025-04-14' not found in models.yaml".
        evaluator = models.role("evaluator", a.evaluator_model, "evaluator")
        if evaluator:
            argv += ["--evaluator-llm", models.real_id(evaluator)]
        env = {
            "TAU2_LANGUAGE": lang.tau3,
            "TAU2_MODEL_CONFIG_PATH": str(cfgs["tau3"]),
            "TAU2_DATA_DIR": str(DATA / "tau3"),
        }
        # banking_knowledge builds a BM25 index and would otherwise try to
        # download its tokenizer mid-run. Pass through an offline checkpoint
        # when the environment names one.
        saved = _tokenizer_env()
        for var in ("TAU2_BM25_TOKENIZER_PATH", "TAU2_BM25_TOKENIZER_OFFLINE",
                    "TAU2_BM25_TOKENIZER_CACHE"):
            value = os.environ.get(var) or saved.get(var)
            if value:
                env[var] = value
        notes = []
        if domain == "banking_knowledge":
            notes.append("needs the `knowledge` extra (retrieval pipeline)")
        steps.append(Step("tau3", lang, argv, env,
                          BENCHMARKS / "tau3",
                          f"data/tau3/simulations/{save_to}/results.json",
                          notes))
    return steps


def _plan_vitabench(a, lang, models, cfgs, run_id) -> list[Step]:
    if lang.vita is None:
        die(f"vitabench does not ship {lang.name!r} (German is tau3-only)")
    domains = _domains_for("vitabench", a.domain)
    if domains is None:
        warn(f"skipping vitabench: none of {a.domain} is one of its "
             f"domains ({', '.join(STANDARD_DOMAINS['vitabench'])})")
        return []
    steps = []
    for domain in domains:
        # `cross` is expressed as the comma-joined domain list.
        dom_arg = "delivery,instore,ota" if domain == "cross" else domain
        save_to = f"{run_id}__{lang.code}__{domain}.json"
        argv = [
            str(venv_bin("vitabench", "vita")), "run",
            "--domain", dom_arg,
            "--agent-llm", models.real_id(models.require(a.agent_model, "agent")),
            "--language", lang.vita,
            "--num-trials", str(a.num_trials),
            "--task-subset", a.subset,
            "--max-concurrency", str(a.concurrency),
            "--save-to", save_to,
        ]
        user = models.role("user", a.user_model, "user-simulator")
        if a.num_tasks:
            argv += ["--num-tasks", str(a.num_tasks)]
        if user:
            argv += ["--user-llm", models.real_id(user)]
        evaluator = models.role("evaluator", a.evaluator_model, "evaluator")
        if evaluator:
            argv += ["--evaluator-llm", models.real_id(evaluator)]
        steps.append(Step("vitabench", lang, argv,
                          {"VITA_MODEL_CONFIG_PATH": str(cfgs["vitabench"]),
                           "VITA_DATA_DIR": str(DATA / "vitabench"),
                           # resume a re-run --run-id without a y/n prompt, as tau3
                           "VITA_AUTO_RESUME": "1"},
                          BENCHMARKS / "vitabench",
                          f"data/vitabench/simulations/{save_to}",
                          ["scored by an LLM judge -- keep --evaluator-model fixed "
                           "across the systems you compare"]))
    return steps


def _plan_deepplanning(a, lang, models, cfgs, run_id) -> list[Step]:
    if lang.deep is None:
        die(f"deepplanning does not ship {lang.name!r} (German is tau3-only)")
    domains = _domains_for("deepplanning", a.domain)
    if domains is None:
        warn(f"skipping deepplanning: none of {a.domain} is one of its "
             f"domains ({', '.join(STANDARD_DOMAINS['deepplanning'])})")
        return []
    base_env = {
        "DOMAINS": " ".join(domains),
        "BENCHMARK_MODEL": models.require(a.agent_model, "agent"),
        "BENCHMARK_TASK_SUBSET": a.subset,
        "DEEPPLANNING_LANGUAGE": lang.deep,
        "DEEPPLANNING_MODELS_CONFIG": str(cfgs["deepplanning"]),
        "DEEPPLANNING_DATA_DIR": str(DATA / "deepplanning"),
        "SHOPPING_WORKERS": str(a.concurrency),
        "TRAVEL_WORKERS": str(a.concurrency),
        **{k: (os.environ.get(k) or v) for k, v in _tokenizer_env().items()
           if k.startswith("SHOPPING_")},
        "PATH": f"{VENVS / 'deepplanning' / 'bin'}{os.pathsep}{os.environ.get('PATH', '')}",
    }
    conv = models.role("conversion", a.conversion_model, "conversion")
    if conv:
        base_env["TRAVEL_CONVERSION_MODEL"] = conv
    if a.shopping_levels:
        base_env["SHOPPING_LEVELS"] = a.shopping_levels

    notes = ["travel runs inference -> conversion -> evaluation; "
             "the conversion model reformats plans before scoring"]

    # deepplanning has no --num-trials flag, so N trials = N isolated runs of
    # run_all.sh. Each trial writes into its own directory via the two knobs the
    # domain scripts already expose -- TRAVEL_OUTPUT_DIR (travel) and
    # DEEPPLANNING_RUN_DIR (shopping's external-runtime mode) -- so trials never
    # overwrite each other and pass^k can line cases up across trials by id.
    def trial_env(base: dict, trial: int) -> dict:
        root = RESULTS / run_id / "deepplanning" / lang.code / f"trial{trial}"
        return {**base,
                "TRAVEL_OUTPUT_DIR": str(root / "travel"),
                "DEEPPLANNING_RUN_DIR": str(root / "shopping")}

    def out_hint(trial: int) -> str:
        return f"results/{run_id}/deepplanning/{lang.code}/trial{trial}"

    if not a.num_tasks:
        return [Step("deepplanning", lang, ["bash", "run_all.sh"],
                     trial_env(base_env, t), BENCHMARKS / "deepplanning",
                     out_hint(t), notes if t == 1 else [], trial=t)
                for t in range(1, a.num_trials + 1)]

    # --num-tasks smoke path: deepplanning has no --num-tasks, so a smoke run
    # selects explicit IDs (they outrank the subset). DEEPPLANNING_TASK_IDS is
    # ONE flat list read by both domains, and they number cases differently
    # (travel 0..119, shopping 1..50), so a merged list names cases one domain
    # lacks and aborts -- emit one step per (trial, domain) with only its IDs.
    subsets = DATA / "deepplanning" / "task_subsets" / a.subset
    levels = (a.shopping_levels or "1").split()

    def first_ids(unit: str) -> list[str]:
        f = subsets / f"{unit}.txt"
        if not f.exists():
            return []
        ids = [ln.strip() for ln in f.read_text(encoding="utf-8").splitlines()
               if ln.strip() and not ln.startswith("#")]
        return ids[:a.num_tasks]

    steps: list[Step] = []
    for t in range(1, a.num_trials + 1):
        for domain in domains:
            units = ["travel"] if domain == "travel" else [f"shopping_level{n}" for n in levels]
            picked: list[str] = []
            seen: set[str] = set()
            for unit in units:
                for i in first_ids(unit):
                    if i not in seen:
                        seen.add(i)
                        picked.append(i)
            step_env = {**trial_env(base_env, t), "DOMAINS": domain}
            if picked:
                step_env["DEEPPLANNING_TASK_IDS"] = ",".join(picked)
            if domain == "shopping":
                step_env["SHOPPING_LEVELS"] = a.shopping_levels or "1"
            steps.append(Step("deepplanning", lang, ["bash", "run_all.sh"], step_env,
                              BENCHMARKS / "deepplanning", out_hint(t),
                              notes if (domain == "travel" and t == 1) else [], trial=t))
    return steps


def _claw_smoke_subset(subset: str, n: int) -> str:
    """Generate the task subset a claw --num-tasks run uses; return its name.

    claw has no --num-tasks, only --task-subset, so a smoke run gets a subset of
    its own: the first N ids of each split of the requested one. Every split
    keeps at least one task because claw rejects an empty manifest. The
    `smoke-` prefix keeps it from ever shadowing a frozen subset, and these
    directories are git-ignored.
    """
    claw = BENCHMARKS / "claw"
    name = f"smoke-{subset}-{n}"
    out = claw / "task_subsets" / name
    for split, prefix in (("general", "T"), ("multimodal", "M"), ("multi_turn", "C")):
        if subset == "full":
            ids = sorted(d.name for d in (claw / "tasks").iterdir()
                         if d.name.startswith(prefix) and (d / "task.yaml").exists())
        else:
            src = claw / "task_subsets" / subset / f"{split}.txt"
            if not src.exists():
                die(f"claw has no task subset {subset!r} (missing {src.relative_to(REPO)})")
            ids = [ln.strip() for ln in src.read_text(encoding="utf-8").splitlines()
                   if ln.strip() and not ln.lstrip().startswith("#")]
        if not ids:
            die(f"claw subset {subset!r} has no {split} tasks to sample from")
        out.mkdir(parents=True, exist_ok=True)
        (out / f"{split}.txt").write_text("\n".join(ids[:n]) + "\n", encoding="utf-8")
    return name


def _plan_claw(a, lang, models, cfgs, run_id) -> list[Step]:
    if lang.claw is None:
        die(f"claw does not ship {lang.name!r}")
    domains = _domains_for("claw", a.domain)
    if domains is None:
        warn(f"skipping claw: none of {a.domain} is one of its "
             f"splits ({', '.join(STANDARD_DOMAINS['claw'])})")
        return []
    if len(domains) != len(STANDARD_DOMAINS['claw']):
        warn(f"skipping claw: its splits run together as one batch, so --domain "
             f"cannot select {', '.join(domains)} on its own")
        return []

    agent = models.require(a.agent_model, "agent")
    judge = models.role("evaluator", a.evaluator_model, "evaluator")
    if not judge:
        die("claw scores with an LLM judge: set roles.evaluator or pass --evaluator-model")
    user = models.role("user", a.user_model, "user-simulator")
    if not user:
        die("claw's multi_turn split needs a user simulator: set roles.user "
            "or pass --user-model")
    cfg = models.render_claw(agent, judge, user, run_id)

    subset = _claw_smoke_subset(a.subset, a.num_tasks) if a.num_tasks else a.subset
    # --continue makes the output directory ours (without it claw invents a
    # timestamped one) and makes a re-run resume: each task is filled up to N
    # graded trials, finished ones are skipped. claw insists it already exists.
    trace_dir = RESULTS / run_id / "claw" / lang.code
    trace_dir.mkdir(parents=True, exist_ok=True)
    argv = [
        str(venv_bin("claw", "claw-eval")), "batch",
        "--tasks-dir", "tasks",
        "--task-subset", subset,
        "--language", lang.claw,
        "--config", str(cfg),
        "--trials", str(a.num_trials),
        "--parallel", str(a.concurrency),
        "--port-base-offset", str(a.claw_port_offset),
        "--continue", str(trace_dir),
    ]
    notes = []
    if a.claw_no_sandbox:
        notes.append("--claw-no-sandbox: tools run without Docker; scores are not "
                     "comparable with sandboxed runs")
    else:
        argv.append("--sandbox")
        notes.append("needs Docker and the claw-eval-agent:latest image (`bench setup --only claw`)")
    notes.append("scored by an LLM judge -- keep --evaluator-model fixed "
                 "across the systems you compare")
    # Traces strip media and are rehydrated from tasks/<id>/fixtures when graded.
    # claw finds that directory by walking up from the trace, which fails once
    # traces live under results/ instead of inside its own tree; point it there.
    env = {"CLAW_EVAL_FIXTURES_ROOT": str(BENCHMARKS / "claw" / "tasks")}
    # claw scales every task's time limit by this variable. It would reach claw
    # from the caller's shell either way; copying it into the step puts it in
    # the manifest, since a longer limit changes scores.
    mult = os.environ.get("CLAW_EVAL_TIMEOUT_MULT", "").strip()
    if mult and mult != "1":
        env["CLAW_EVAL_TIMEOUT_MULT"] = mult
        notes.append(f"CLAW_EVAL_TIMEOUT_MULT={mult}: task time limits scaled x{mult}; "
                     "scores are not comparable with default-limit runs")
    out = f"results/{run_id}/claw/{lang.code}/batch_results.json"
    # Second pass: grade any trace whose agent run finished but whose judge
    # call failed, then fill trials that are still short. On a clean first pass
    # it only rewrites batch_results.json / batch_summary.json from the traces.
    return [
        Step("claw", lang, argv, env, BENCHMARKS / "claw", out, notes),
        Step("claw", lang, argv + ["--regrade"], env, BENCHMARKS / "claw", out,
             ["regrade pass: grades traces the judge missed, refills short tasks"]),
    ]


