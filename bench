def cmd_check(a) -> int:
    """Verify the tree is runnable without making a single LLM call."""
    reg = LanguageRegistry(CONFIGS / "languages.yaml")
    problems: list[str] = []
    notes: list[str] = []

    def ok(label: str, good: bool, detail: str = "") -> None:
        print(f"  [{'ok' if good else 'FAIL'}] {label}{(' -- ' + detail) if detail else ''}")
        if not good:
            problems.append(label)

    print("data:")
    checks = [
        ("tau3 domains", DATA / "tau3/tau2/domains"),
        ("tau3 task subsets", DATA / "tau3/task_subsets/standard"),
        ("vitabench domains", DATA / "vitabench/vita/domains"),
        ("vitabench task subsets", DATA / "vitabench/task_subsets/standard"),
        ("deepplanning travel db", DATA / "deepplanning/travelplanning/database"),
        ("deepplanning shopping db", DATA / "deepplanning/shoppingplanning/database_level1"),
        ("deepplanning task subsets", DATA / "deepplanning/task_subsets/standard"),
        ("claw tasks", BENCHMARKS / "claw/tasks"),
        ("claw task subsets", BENCHMARKS / "claw/task_subsets/standard"),
    ]
    for label, path in checks:
        ok(label, path.exists(), "" if path.exists() else f"missing {path.relative_to(REPO)}")

    print("\nper-language data:")
    # Probe the files evaluation actually anchors on, not just the ones that are
    # easy to translate. tau3 in particular once carried policy/tasks/tools for a
    # language with no localized database behind them -- a language that looks
    # present but cannot be scored. Every probe below must include a database.
    # English is the baseline in tau3 and in deepplanning's shopping databases:
    # its files carry no language suffix (db.json, database_level1). Suffixing
    # them would report the baseline as missing.
    def _sfx(is_baseline: bool, tag: str) -> str:
        return "" if is_baseline else f"_{tag}"

    # claw localizes per task: every task in the standard subset needs a
    # task_<code>.yaml, except in the language it was written in (en or zh),
    # where task.yaml itself is the baseline. Read each source language once.
    claw_src: dict[str, str] = {}
    claw_root = BENCHMARKS / "claw"
    for split in STANDARD_DOMAINS['claw']:
        f = claw_root / "task_subsets/standard" / f"{split}.txt"
        if not f.exists():
            continue
        for tid in (ln.strip() for ln in f.read_text(encoding="utf-8").splitlines()):
            if tid and not tid.startswith("#"):
                y = claw_root / "tasks" / tid / "task.yaml"
                doc = (_load_yaml(y) or {}) if y.exists() else {}
                claw_src[tid] = str((doc.get("prompt") or {}).get("language") or "").lower()

    probes = {
        "tau3": lambda l: (lambda s: [
            DATA / f"tau3/tau2/domains/airline/db{s}.json",
            DATA / f"tau3/tau2/domains/airline/tasks{s}.json",
            DATA / f"tau3/tau2/domains/retail/db{s}.json",
            DATA / f"tau3/tau2/domains/telecom/db{s}.toml",
            DATA / f"tau3/tau2/domains/telecom/user_db{s}.toml",
            DATA / f"tau3/tau2/domains/banking_knowledge/db{s}.json",
        ])(_sfx(l.code == "en", l.tau3)),
        "vitabench": lambda l: [
            DATA / f"vitabench/vita/domains/{d}/tasks_{l.code}.json"
            for d in ("delivery", "instore", "ota", "cross_domain")
        ],
        "deepplanning": lambda l: [
            BENCHMARKS / f"deepplanning/travelplanning/data/travelplanning_query_{l.code}.json",
            DATA / f"deepplanning/travelplanning/database/database_{l.code}",
            DATA / ("deepplanning/shoppingplanning/database_level1"
                    + _sfx(l.code == "en", l.code)),
        ],
        "claw": lambda l: [
            claw_root / "tasks" / tid / ("task.yaml" if src == l.claw else f"task_{l.claw}.yaml")
            for tid, src in claw_src.items()
        ],
    }
    for bench_name, probe in probes.items():
        broken: list[str] = []
        for l in reg:
            if l.for_benchmark(bench_name) is None:
                continue
            gone = [p for p in probe(l) if not p.exists()]
            if gone:
                broken.append(f"{l.code}({len(gone)} missing, e.g. {gone[0].name})")
        ok(f"{bench_name}: all {sum(1 for l in reg if l.for_benchmark(bench_name))} "
           f"languages complete", not broken,
           "; ".join(broken[:4]) if broken else "")

    print("\nenvironments:")
    for name in BENCH_NAMES:
        exe = {"tau3": "tau2", "vitabench": "vita", "deepplanning": "python",
               "claw": "claw-eval"}[name]
        p = venv_bin(name, exe)
        present = p.exists()
        print(f"  [{'ok' if present else '--'}] {name} venv"
              f"{'' if present else '  (run `bench setup`)'}")
        if not present:
            notes.append(f"{name} venv not built")
    # claw's paper numbers ran its tools inside a Docker sandbox.
    docker = shutil.which("docker")
    image = bool(docker) and subprocess.run(
        [docker, "image", "inspect", "claw-eval-agent:latest"],
        capture_output=True).returncode == 0
    print(f"  [{'ok' if image else '--'}] claw sandbox image claw-eval-agent:latest"
          f"{'' if image else '  (needs Docker; `bench setup --only claw`)'}")
    if not image:
        notes.append("claw sandbox image not built (or pass --claw-no-sandbox)")

    print("\nconfig:")
    cfg_path = CONFIGS / "models.yaml"
    if cfg_path.exists():
        models = ModelConfig(cfg_path)
        ok("models.yaml parses, no literal keys", True)
        for role in ("user", "evaluator", "conversion"):
            name = models.roles.get(role)
            ok(f"role {role} -> {name or '(unset)'}", bool(name and name in models._names))
    else:
        print("  [--] configs/models.yaml absent  (cp configs/models.yaml.example ...)")
        notes.append("models.yaml absent")

    print()
    if problems:
        print(f"{len(problems)} problem(s): " + "; ".join(problems))
        return 1
    if notes:
        print("runnable once you finish: " + "; ".join(notes))
        return 0
    print("all checks passed -- ready to run")
    return 0


def _create_venv(py: str, target: Path) -> None:
    """Create a virtualenv, falling back to the `virtualenv` tool.

    Debian and Ubuntu ship `python3.X` without ensurepip (it lives in a separate
    python3.X-venv package), so `python -m venv` fails on a stock system with a
    message about apt. `virtualenv` vendors its own pip and does not need it, so
    prefer failing over to it rather than telling the user to become root.
    """
    r = subprocess.run([py, "-m", "venv", str(target)],
                       capture_output=True, text=True)
    if r.returncode == 0:
        return
    shutil.rmtree(target, ignore_errors=True)
    vv = shutil.which("virtualenv")
    if vv:
        print(f"  python -m venv unavailable for {py}; using virtualenv")
        subprocess.run([vv, "-p", py, str(target)], check=True)
        return
    die(
        f"cannot create a virtualenv with {py}.\n"
        f"  {(r.stderr or r.stdout).strip().splitlines()[0] if (r.stderr or r.stdout).strip() else ''}\n"
        f"  Install the matching venv package (e.g. apt install python3.10-venv)\n"
        f"  or `pip install virtualenv` and re-run."
    )


def _save_tokenizer_env(**pairs: str) -> None:
    """Persist what setup prepared so `bench run` does not need re-exporting.

    Both tokenizers are configured through environment variables, and setup used
    to only print the `export` lines. Anyone who ran setup, opened a new shell
    and then ran a benchmark hit "tokenizer is not prepared" for something that
    had in fact just been prepared. Recording it here closes that gap; a real
    environment variable still wins, so a deliberate override keeps working.
    """
    RUNTIME.mkdir(exist_ok=True)
    path = RUNTIME / "tokenizers.json"
    stored = {}
    if path.exists():
        try:
            stored = json.loads(path.read_text(encoding="utf-8"))
        except json.JSONDecodeError:
            stored = {}
    stored.update({k: v for k, v in pairs.items() if v})
    path.write_text(json.dumps(stored, indent=2), encoding="utf-8")


def _tokenizer_env() -> dict[str, str]:
    """What setup recorded, for `bench run` to pass down."""
    path = RUNTIME / "tokenizers.json"
    if not path.exists():
        return {}
    try:
        return {k: str(v) for k, v in json.loads(path.read_text(encoding="utf-8")).items()}
    except json.JSONDecodeError:
        return {}


def _prepare_knowledge_tokenizer(venv: Path, src: Path, a) -> None:
    """Pre-fetch the BM25 tokenizer tau3's banking_knowledge domain needs.

    That domain builds a BM25 index over its document corpus and pulls
    Qwen/Qwen3-0.6B from Hugging Face the first time it runs. Behind a
    TLS-inspecting proxy the download fails and every banking task dies, so
    fetch it here -- or point --tokenizer-model at a local Qwen3 checkpoint,
    which the whole Qwen3 family shares a tokenizer with.
    """
    if a.tokenizer_model:
        print(f"  banking_knowledge tokenizer: using {a.tokenizer_model}")
        _save_tokenizer_env(TAU2_BM25_TOKENIZER_PATH=a.tokenizer_model,
                            TAU2_BM25_TOKENIZER_OFFLINE="1")
        return
    print("  pre-fetching the banking_knowledge BM25 tokenizer ...")
    r = subprocess.run([str(venv / "bin" / "tau2"), "knowledge",
                        "prefetch-tokenizer"], cwd=src)
    if r.returncode != 0:
        warn("could not pre-fetch the banking_knowledge tokenizer. If that was a "
             "TLS/certificate error, re-run setup with --tokenizer-model "
             "/path/to/a/local/Qwen3-checkpoint, or drop the domain with "
             "--domain airline retail telecom")


def _prepare_shopping_tokenizer(venv: Path, src: Path, a) -> None:
    """Pin the BM25 tokenizer deepplanning's shopping domain needs.

    Shopping refuses to run until this has been done: it never downloads a
    tokenizer mid-benchmark, so an unprepared cache fails the whole level with
    "Shopping BM25 tokenizer is not prepared".

    By default the tokenizer comes from Hugging Face. Behind a TLS-inspecting
    proxy that fails with a self-signed-certificate error, so point
    --tokenizer-model at a local copy of the model directory and the download is
    skipped entirely.
    """
    cache = a.tokenizer_cache or os.environ.get("SHOPPING_BM25_TOKENIZER_CACHE_DIR") \
        or str(REPO / ".cache" / "tokenizer")
    argv = [str(venv / "bin" / "python"),
            str(src / "scripts" / "prepare_shopping_tokenizer.py"),
            "--cache-dir", cache]
    if a.tokenizer_model:
        argv += ["--model", a.tokenizer_model, "--revision",
                 a.tokenizer_revision or "local"]
    print("  preparing the shopping BM25 tokenizer ...")
    r = subprocess.run(argv, cwd=src)
    if r.returncode != 0:
        warn("tokenizer preparation failed -- deepplanning's shopping domain will "
             "refuse to run. If the failure was a TLS/certificate error, re-run "
             "`bench setup --only deepplanning --force` with "
             "--tokenizer-model /path/to/a/local/Qwen3-8B")
    else:
        print(f"  tokenizer cache: {cache}")
        _save_tokenizer_env(SHOPPING_BM25_TOKENIZER_CACHE_DIR=cache)
        if a.tokenizer_model:
            _save_tokenizer_env(SHOPPING_BM25_TOKENIZER=a.tokenizer_model,
                                SHOPPING_BM25_TOKENIZER_REVISION=a.tokenizer_revision or "local")


def _build_claw_image(venv: Path, src: Path) -> None:
    """Build the Docker image claw's --sandbox runs agent tools in.

    Skipped, with a warning rather than a failure, when Docker is absent or the
    image already exists: everything else claw needs is installed by then, and
    `bench run --claw-no-sandbox` still works without it.
    """
    docker = shutil.which("docker")
    if not docker:
        warn("docker not found -- claw's --sandbox needs it. Install Docker and "
             "re-run `bench setup --only claw`, or run with --claw-no-sandbox")
        return
    if subprocess.run([docker, "image", "inspect", "claw-eval-agent:latest"],
                      capture_output=True).returncode == 0:
        print("  sandbox image claw-eval-agent:latest present")
        return
    print("  building the claw sandbox image (claw-eval-agent:latest) ...")
    r = subprocess.run([str(venv / "bin" / "claw-eval"), "build-image"], cwd=src)
    if r.returncode != 0:
        warn("`claw-eval build-image` failed -- claw runs need --claw-no-sandbox "
             "until it is built")


def cmd_setup(a) -> int:
    VENVS.mkdir(exist_ok=True)
    for name in (a.only or BENCH_NAMES):
        py = _find_python(name)
        target = VENVS / name
        src = BENCHMARKS / name
        print(f"\n=== {name} ({py}) ===")
        if target.exists() and not a.force:
            # The venv is the expensive part, but the tokenizer step is separate
            # and cheap -- and re-running setup to fix a tokenizer is the natural
            # thing to try. Skip the install, still (re)prepare the tokenizers.
            print("  venv exists, skipping install (use --force to rebuild)")
            if not a.dry_run:
                if name == "tau3":
                    _prepare_knowledge_tokenizer(target, src, a)
                elif name == "deepplanning":
                    _prepare_shopping_tokenizer(target, src, a)
                elif name == "claw":
                    _build_claw_image(target, src)
            continue
        if a.dry_run:
            print(f"  would create {target} with {py}")
            continue
        _create_venv(py, target)
        pip = str(target / "bin" / "pip")
        subprocess.run([pip, "install", "-q", "--upgrade", "pip", "wheel"], check=True)
        if name == "deepplanning":
            subprocess.run([pip, "install", "-q", "-r", str(src / "requirements.txt")], check=True)
            # qwen-agent reaches soundfile through qwen_agent.utils.utils, but
            # neither its own metadata nor requirements.txt declares it, so
            # importing travelplanning/tools/ fails without this.
            subprocess.run([pip, "install", "-q", "soundfile"], check=True)
            _prepare_shopping_tokenizer(target, src, a)
        elif name == "claw":
            # mock: the FastAPI services tasks call into; sandbox: the Docker
            # client --sandbox drives.
            subprocess.run([pip, "install", "-q", "-e", f"{src}[mock,sandbox]"], check=True)
            _build_claw_image(target, src)
        else:
            subprocess.run([pip, "install", "-q", "-e", str(src)], check=True)
        if name == "tau3":
            # Two extras, both mandatory here even though this release is
            # text-only:
            #   knowledge -- the banking_knowledge retrieval pipeline.
            #   voice     -- not for running voice, but because tau2's import
            #                graph reaches it unconditionally. agent/__init__.py,
            #                agent/base/, runner/batch.py and user/ all import
            #                tau2.voice at module level (~35 sites), so `tau2
            #                run --domain airline` cannot even start without it.
            #                Chasing ModuleNotFoundError one package at a time is
            #                a trap; install the extra and move on.
            subprocess.run([pip, "install", "-q",
                            "rank-bm25", "openai", "transformers",       # knowledge
                            "scipy", "websockets>=13.0", "pyaudio", "jiwer",
                            "pydub", "tqdm", "aiohttp", "elevenlabs",
                            "deepgram-sdk", "google-genai", "boto3",
                            "google-auth"],                              # voice
                           check=True)
            _prepare_knowledge_tokenizer(target, src, a)
        print(f"  built {target}")
    return 0


def cmd_run(a) -> int:
    reg = LanguageRegistry(CONFIGS / "languages.yaml")
    models = ModelConfig(CONFIGS / "models.yaml")
    cfgs = models.render()

    benches = BENCH_NAMES if a.benchmark == "all" else (a.benchmark,)
    langs = (list(reg) if a.language.strip().lower() == "all"
             else [reg.resolve(s) for s in a.language.split(",")])
    run_id = a.run_id or time.strftime("%Y%m%d_%H%M%S")

    steps: list[Step] = []
    for lang in langs:
        for name in benches:
            if a.benchmark == "all" and lang.for_benchmark(name) is None:
                warn(f"skipping {name} for {lang.name}: not shipped")
                continue
            steps += PLANNERS[name](a, lang, models, cfgs, run_id)

    if not steps:
        die("nothing to run")

    out_dir = RESULTS / run_id
    out_dir.mkdir(parents=True, exist_ok=True)
    manifest = {
        "run_id": run_id,
        "agent_model": a.agent_model,
        "subset": a.subset,
        "num_trials": a.num_trials,
        "languages": [l.code for l in langs],
        "benchmarks": list(benches),
        "steps": [],
    }

    print(f"run {run_id}: {len(steps)} step(s)\n")
    failures = 0
    for i, step in enumerate(steps, 1):
        head = (f"[{i}/{len(steps)}] {step.benchmark} / {step.language.code}"
                + (f" / trial {step.trial}" if step.trial is not None else ""))
        print(f"{head}\n  $ {' '.join(step.argv)}")
        for k, v in sorted(step.env.items()):
            if k != "PATH":
                print(f"    {k}={v}")
        for note in step.notes:
            print(f"    note: {note}")
        step_row = {
            "benchmark": step.benchmark,
            "language": step.language.code,
            "argv": step.argv,
            "env": {k: v for k, v in step.env.items() if k != "PATH"},
            "output": step.output_hint,
        }
        if step.trial is not None:
            step_row["trial"] = step.trial
        manifest["steps"].append(step_row)
        if a.dry_run:
            print("    (dry run -- not executed)\n")
            continue
        env = {**os.environ, **step.env}
        rc = subprocess.run(step.argv, cwd=step.cwd, env=env).returncode
        status = "ok" if rc == 0 else f"FAILED (exit {rc})"
        manifest["steps"][-1]["exit_code"] = rc
        failures += rc != 0
        print(f"    -> {status}\n")

    (out_dir / "manifest.json").write_text(
        json.dumps(manifest, ensure_ascii=False, indent=2), encoding="utf-8")
    print(f"manifest: {(out_dir / 'manifest.json').relative_to(REPO)}")
    if a.dry_run:
        print("dry run complete -- nothing was executed")
        return 0
    if failures:
        print(f"{failures} step(s) failed")
        return 1
    print(f"all steps finished. `bench report --run-id {run_id}` to collect scores.")

    if a.lang_consistency:
        # A separate measurement from task reward, and a separate bill: it makes
        # one judge call per task. Opt-in for that reason.
        print("\nauditing language consistency ...")
        ns = argparse.Namespace(
            run_id=run_id, granularity=a.lang_granularity,
            concurrency=a.concurrency, judge_model=a.lang_judge_model,
            max_tasks_per_language=a.lang_max_tasks, dry_run=False)
        return cmd_lang_check(ns)
    return 0


# Where each benchmark's bulk data comes from (relative to the source tree) and
# where it lands. claw's tasks are the exception that stays inside the code
# tree: its mock services, its per-language peer graders and its subset lookup
# all resolve paths relative to its own checkout, and a peer grader that cannot
# be found silently falls back to the zh grader. Relocating tasks/ would mean
# patching claw, so it is fetched in place and git-ignored instead.
_BULK_DEST = {
    "tau3": ("tau3", DATA / "tau3"),
    "vitabench": ("vitabench", DATA / "vitabench"),
    "deepplanning": ("deepplanning", DATA / "deepplanning"),
    "claw": ("claw/tasks", BENCHMARKS / "claw" / "tasks"),
}

# The marker each benchmark's bulk data leaves behind, used to tell "fetched"
# from "fresh clone". Never a directory that git also populates.
_BULK_MARKER = {
    "tau3": DATA / "tau3/tau2/domains/airline/db.json",
    "vitabench": DATA / "vitabench/vita/domains/delivery/tasks.json",
    "deepplanning": DATA / "deepplanning/travelplanning/database/database_en",
    "claw": BENCHMARKS / "claw/tasks/C01zh_mortgage_prepay/task.yaml",
}


def _has_bulk_data(name: str) -> bool:
    return _BULK_MARKER[name].exists()


def cmd_fetch_data(a) -> int:
    """Download the benchmark data into data/.

    The data is ~14 GB -- far past what GitHub accepts -- so the repository
    carries only code plus the frozen task_subsets/ lists, and the bulk is
    fetched here. Three runners are pointed at data/ through TAU2_DATA_DIR /
    VITA_DATA_DIR / DEEPPLANNING_DATA_DIR, which `bench run` sets for you;
    claw's tasks/ is filled in place under benchmarks/claw/ (see _BULK_DEST).
    """
    source = a.source or os.getenv("REQUEST_DATA_SOURCE") or DATA_SOURCE_DEFAULT
    DATA.mkdir(exist_ok=True)

    if not source:
        die(
            "no data source configured yet.\n"
            "  Set DATA_SOURCE_DEFAULT in bench, pass --source <url-or-path>,\n"
            "  or export REQUEST_DATA_SOURCE. A local path is copied; an https URL\n"
            "  or a huggingface.co dataset id is downloaded."
        )

    local = Path(source).expanduser()
    if local.is_dir():
        print(f"copying benchmark data from {local}")
        for name in BENCH_NAMES:
            rel, dst = _BULK_DEST[name]
            src = local / rel
            if not src.is_dir():
                warn(f"{src} not found, skipping")
                continue
            # Test for the bulk payload, not for the directory. data/<name>/
            # always exists in a fresh clone -- the frozen task_subsets/ lists
            # are committed there -- so an exists() check would report every
            # clone as already fetched and copy nothing.
            if _has_bulk_data(name) and not a.force:
                print(f"  {name}: already present, skipping (use --force)")
                continue
            if a.dry_run:
                print(f"  would copy {src} -> {dst}")
                continue
            print(f"  {name} ...", flush=True)
            shutil.copytree(src, dst, dirs_exist_ok=True)
        return 0 if a.dry_run else cmd_check(a)

    die(
        f"remote fetch from {source!r} is not wired up yet.\n"
        "  Publish the data first, then set DATA_SOURCE_DEFAULT in bench.\n"
        "  Meanwhile `--source /path/to/data` copies from a local staging tree."
    )


def cmd_lang_check(a) -> int:
    """Audit what language the agent actually replied in.

    Task reward and language consistency are different measurements: an agent
    can score full reward while answering a Thai user in English. This runs the
    second one over a finished run.
    """
    argv = [sys.executable, str(REPO / "scripts" / "lang_consistency.py"),
            "--run-id", a.run_id, "--granularity", a.granularity,
            "--concurrency", str(a.concurrency)]
    if a.judge_model:
        argv += ["--judge-model", a.judge_model]
    if a.max_tasks_per_language:
        argv += ["--max-tasks-per-language", str(a.max_tasks_per_language)]
    if getattr(a, "dry_run", False):
        argv += ["--dry-run"]
    return subprocess.run(argv).returncode


def cmd_clean(a) -> int:
    """Remove generated state: rendered configs, and optionally run output.

    .runtime/ holds the per-benchmark model configs with the API key expanded
    into them. They are git-ignored and mode 0600, but they are still a real
    credential sitting on disk, so clear them when you are done -- especially
    before archiving or sharing a working tree.
    """
    removed = []
    for target in (RUNTIME,):
        if target.exists():
            shutil.rmtree(target)
            removed.append(str(target.relative_to(REPO)))
    if a.configs and (CONFIGS / "models.yaml").exists():
        (CONFIGS / "models.yaml").unlink()
        removed.append("configs/models.yaml")
    if a.results and RESULTS.exists():
        shutil.rmtree(RESULTS)
        removed.append("results/")
    if a.venvs and VENVS.exists():
        shutil.rmtree(VENVS)
        removed.append(".venvs/")
    print("removed: " + (", ".join(removed) if removed else "nothing to remove"))
    if not a.results:
        print("run output under results/ kept (pass --results to drop it)")
    return 0


def cmd_report(a) -> int:
    """Each benchmark's own headline metric, then pass^1 / pass^3 on one scale."""
    rc = 0
    for script in ("report.py", "passk_report.py"):
        rc |= subprocess.run([sys.executable, str(REPO / "scripts" / script),
                              "--run-id", a.run_id]).returncode
        print()
    return rc


# --------------------------------------------------------------------------

def main() -> int:
    # Python block-buffers stdout when it is not a terminal, so under `nohup
    # bench run ... > log` the step-by-step progress stays invisible until the
    # process exits -- exactly the case where you most want to watch it.
    try:
        sys.stdout.reconfigure(line_buffering=True)
        sys.stderr.reconfigure(line_buffering=True)
    except AttributeError:      # pragma: no cover -- very old interpreters
        pass

    p = argparse.ArgumentParser(prog="bench", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)

    sub.add_parser("languages", help="list supported languages and their per-benchmark spellings")

    c = sub.add_parser("check", help="verify data and config without calling any model")
    c.set_defaults(fn=cmd_check)

    s = sub.add_parser("setup", help="build the four virtualenvs")
    s.add_argument("--only", nargs="+", choices=BENCH_NAMES)
    s.add_argument("--force", action="store_true", help="rebuild venvs that already exist")
    s.add_argument("--dry-run", action="store_true")
    s.add_argument("--tokenizer-model",
                   help="local directory holding the Qwen3-8B tokenizer, for "
                        "deepplanning's shopping BM25 index. Use this when the "
                        "Hugging Face download is blocked (TLS interception)")
    s.add_argument("--tokenizer-revision", default="local")
    s.add_argument("--tokenizer-cache",
                   help="where to place the prepared tokenizer "
                        "(default: .cache/tokenizer)")
    s.set_defaults(fn=cmd_setup)

    r = sub.add_parser("run", help="run one or more benchmarks")
    r.add_argument("--benchmark", "-b", default="all", choices=(*BENCH_NAMES, "all"))
    r.add_argument("--language", "-l", required=True,
                   help="language code or name; comma-separated for several, "
                        "or 'all' for the 23 languages")
    r.add_argument("--agent-model", required=True, help="the system under evaluation")
    r.add_argument("--user-model", help="override the user simulator (default: roles.user)")
    r.add_argument("--evaluator-model", help="override the LLM judge (default: roles.evaluator)")
    r.add_argument("--conversion-model", help="override deepplanning's plan converter")
    r.add_argument("--domain", nargs="+", help="restrict to these domains")
    r.add_argument("--subset", default="standard",
                   help="'standard' (default, the frozen, roughly half-size release "
                        "subset), 'full', or a custom subset name")
    r.add_argument("--num-tasks", type=int,
                   help="run only the first N tasks of the selected subset. For "
                        "smoke tests -- the default is the whole subset "
                        "(212/200/120/167 tasks per language). claw takes the "
                        "first N of each of its three splits")
    r.add_argument("--shopping-levels",
                   help="deepplanning shopping levels, e.g. '1' or '1 2 3' "
                        "(default: all three; just level 1 under --num-tasks)")
    r.add_argument("--num-trials", type=int, default=3,
                   help="independent trials per task (default 3, as in the paper: "
                        "pass^3 needs three). 1 is enough for a smoke test")
    r.add_argument("--concurrency", type=int, default=4)
    r.add_argument("--claw-no-sandbox", action="store_true",
                   help="run claw's tools on the host instead of in Docker. Scores "
                        "are not comparable with sandboxed (published) runs")
    r.add_argument("--claw-port-offset", type=int, default=0,
                   help="shift claw's mock-service ports (9100+) so two runs can "
                        "share a host")
    r.add_argument("--run-id", help="reuse an id to resume; default is a timestamp")
    r.add_argument("--dry-run", action="store_true",
                   help="print exactly what would run, execute nothing")
    r.add_argument("--lang-consistency", action="store_true",
                   help="after the run, judge whether the agent actually replied "
                        "in the requested language (one judge call per task)")
    r.add_argument("--lang-granularity", choices=("task", "language"),
                   default="task",
                   help="task (default): judge each task and report the rate; "
                        "language: one truncated blob per language")
    r.add_argument("--lang-judge-model",
                   help="override roles.lang_judge for the consistency audit")
    r.add_argument("--lang-max-tasks", type=int,
                   help="sample at most N tasks per language when auditing")
    r.set_defaults(fn=cmd_run)

    f = sub.add_parser("fetch-data", help="download the benchmark data into data/")
    f.add_argument("--source", help="dataset id, URL, or local directory to copy from")
    f.add_argument("--force", action="store_true", help="overwrite data already present")
    f.add_argument("--dry-run", action="store_true")
    f.set_defaults(fn=cmd_fetch_data)

    lc = sub.add_parser("lang-check",
                        help="audit language consistency of a finished run")
    lc.add_argument("--run-id", required=True)
    lc.add_argument("--granularity", choices=("task", "language"), default="task")
    lc.add_argument("--judge-model")
    lc.add_argument("--max-tasks-per-language", type=int)
    lc.add_argument("--concurrency", type=int, default=8)
    lc.add_argument("--dry-run", action="store_true",
                    help="show what would be judged, call nothing")
    lc.set_defaults(fn=cmd_lang_check)

    cl = sub.add_parser("clean",
                        help="remove .runtime/ (rendered configs holding your key)")
    cl.add_argument("--configs", action="store_true",
                    help="also delete configs/models.yaml")
    cl.add_argument("--results", action="store_true", help="also delete results/")
    cl.add_argument("--venvs", action="store_true", help="also delete .venvs/")
    cl.set_defaults(fn=cmd_clean)

    rp = sub.add_parser("report", help="collect scores from a finished run")
    rp.add_argument("--run-id", required=True)
    rp.set_defaults(fn=cmd_report)

    a = p.parse_args()
    if a.cmd == "languages":
        return cmd_languages(a)
    return a.fn(a)


if __name__ == "__main__":
    raise SystemExit(main())
